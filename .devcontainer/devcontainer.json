{
  "name": "Kea (.NET 7 + Node)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-7.0-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postCreateCommand": "dotnet restore Kea.sln && bash .devcontainer/setup-hve-core.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "GitHub.copilot"
      ]
    }
  }
}